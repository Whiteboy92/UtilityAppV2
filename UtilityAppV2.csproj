<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Resources\Icons\UtilityAppV2Icon.ico</ApplicationIcon>

        <!-- Ship as one self-contained .exe: no loose managed/native DLLs next to
             it, no .NET runtime required on the target machine. ffmpeg/ffprobe/
             yt-dlp stay as external files under Resources\Tools (separate processes,
             cannot be embedded). -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <!-- Bundle EVERYTHING (managed, native, and the ffmpeg/ffprobe content exes)
             into the one .exe. At launch the host extracts it all to a per-user temp
             dir and points AppContext.BaseDirectory there, so the app finds its tools
             with no loose files shipped next to the exe. -->
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <!-- The test project lives under Tests\; keep its sources out of the app build
         (the WPF SDK otherwise globs **/*.cs recursively into this project). -->
    <ItemGroup>
        <Compile Remove="Tests\**" />
        <Page Remove="Tests\**" />
        <None Remove="Tests\**" />
        <Resource Remove="Tests\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Magick.NET-Q8-x64" Version="14.16.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
        <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
        <PackageReference Include="TagLibSharp" Version="2.3.0" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Page Update="Views\DownloadPlaylistView\DownloadPlaylistView.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\FixFileNamesView\FixFileNamesView.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\MoveFilesView\MoveFilesView.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <None Remove="UI Components\TitleBar\Icons\Close.png" />
        <Resource Include="UI Components\TitleBar\Icons\Close.png" />
        <None Remove="UI Components\TitleBar\Icons\Maximize.png" />
        <Resource Include="UI Components\TitleBar\Icons\Maximize.png" />
        <None Remove="UI Components\TitleBar\Icons\Minimize.png" />
        <Resource Include="UI Components\TitleBar\Icons\Minimize.png" />
        <None Remove="Resources\Icons\UtilityAppV2Icon.ico" />
        <!-- ffmpeg/ffprobe are embedded in the single exe (see
             IncludeAllContentForSelfExtract) and auto-extracted to a temp dir at
             runtime, from where they run as child processes. Nothing sits next to
             the shipped .exe. -->
        <None Update="Resources\Tools\ffmpeg.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Resources\Tools\ffprobe.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Resources\Tools\ffplay.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- yt-dlp is NOT bundled. YtDlpProvider downloads it at runtime into
             %LOCALAPPDATA%\UtilityAppV2\Tools and self-updates it there (yt-dlp -U),
             which is the only place those updates can persist. -->
        <None Update="Resources\Icons\UtilityAppV2Icon.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Icons\UtilityAppV2Icon.ico" />
    </ItemGroup>

</Project>